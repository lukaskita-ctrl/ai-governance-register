<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Def_Triage" targetNamespace="http://example.com/bpmn/triage" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collab_Triage">
    <bpmn:participant id="P_bank" name="Proces Triage systemów AI – Bank Przykładowy" processRef="Proc_Triage" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Triage" name="Triage systemów AI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_kom" name="Komitet AI">
        <bpmn:flowNodeRef>T_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_odrz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_compl" name="Compliance i Prawny">
        <bpmn:flowNodeRef>T_esk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_stop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_aigov" name="Zespół AI Governance">
        <bpmn:flowNodeRef>T_spr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_poza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_poza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_kl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_wal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_prz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_gestor" name="Właściciel systemu (biznes)">
        <bpmn:flowNodeRef>S_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ank</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_new" name="Nowy system AI lub istotna zmiana">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="S_timer" name="Termin przeglądu okresowego">
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1">
        <bpmn:timeCycle xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">R/P12M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="T_ank" name="Wypełnij ankietę Triage">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_spr" name="Sprawdź kompletność ankiety">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Ankieta kompletna?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Czy to system AI? (art. 3)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_poza" name="Odnotuj: poza zakresem AI Act">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_poza" name="Poza rejestrem AI">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G3" name="Praktyka zakazana? (art. 5)">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_esk" name="Eskalacja i decyzja o wstrzymaniu">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_stop" name="Wdrożenie wstrzymane">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_kl" name="Przypisz kategorię AI Act i istotność">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="Ścieżka kontroli">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_wal" name="Walidacja, FRIA i DPIA">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_dec" name="Decyzja o dopuszczeniu">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="Dopuszczony?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_odrz" name="Odrzucony">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_prz" name="Przegląd według istotności">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_rej" name="Wpis do Rejestru Systemów AI">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="T_mon" name="Kontrole K1–K7 (skrypt) i raport">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="Input_24c9u6s" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_ok" name="System w rejestrze">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S_new" targetRef="T_ank" />
    <bpmn:sequenceFlow id="f2" sourceRef="S_timer" targetRef="T_ank" />
    <bpmn:sequenceFlow id="f5" name="Nie: uzupełnij" sourceRef="G1" targetRef="T_ank" />
    <bpmn:sequenceFlow id="f3" sourceRef="T_ank" targetRef="T_spr" />
    <bpmn:sequenceFlow id="f4" sourceRef="T_spr" targetRef="G1" />
    <bpmn:sequenceFlow id="f6" name="Tak" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="f7" name="Nie" sourceRef="G2" targetRef="T_poza" />
    <bpmn:sequenceFlow id="f9" name="Tak" sourceRef="G2" targetRef="G3" />
    <bpmn:sequenceFlow id="f8" sourceRef="T_poza" targetRef="E_poza" />
    <bpmn:sequenceFlow id="f10" name="Tak" sourceRef="G3" targetRef="T_esk" />
    <bpmn:sequenceFlow id="f12" name="Nie" sourceRef="G3" targetRef="T_kl" />
    <bpmn:sequenceFlow id="f11" sourceRef="T_esk" targetRef="E_stop" />
    <bpmn:sequenceFlow id="f13" sourceRef="T_kl" targetRef="G4" />
    <bpmn:sequenceFlow id="f14" name="Wysokie ryzyko" sourceRef="G4" targetRef="T_wal" />
    <bpmn:sequenceFlow id="f18" name="Pozostałe" sourceRef="G4" targetRef="T_prz" />
    <bpmn:sequenceFlow id="f15" sourceRef="T_wal" targetRef="T_dec" />
    <bpmn:sequenceFlow id="f16" sourceRef="T_dec" targetRef="G5" />
    <bpmn:sequenceFlow id="f17" name="Nie" sourceRef="G5" targetRef="E_odrz" />
    <bpmn:sequenceFlow id="f20" name="Tak" sourceRef="G5" targetRef="G6" />
    <bpmn:sequenceFlow id="f19" sourceRef="T_prz" targetRef="G6" />
    <bpmn:sequenceFlow id="f21" sourceRef="G6" targetRef="T_rej" />
    <bpmn:sequenceFlow id="f22" sourceRef="T_rej" targetRef="T_mon" />
    <bpmn:sequenceFlow id="f23" sourceRef="T_mon" targetRef="E_ok" />
  </bpmn:process>
